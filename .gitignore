# --- MATLAB Artifacts ---
# Auto-save and temporary files
*.asv
*.m~
.matlab/
bin/
slprj/
*.log

# --- Python Artifacts ---
# Python bytecode cache
__pycache__/
*.py[cod]

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Python virtual environments
.venv/
venv/
env/

# --- Academic/Experiment Results ---
# Generated figures and animations should be excluded to keep the repository lightweight.
# Users can regenerate these by running the provided scripts.
*.fig
*.png
*.pdf
*.eps
*.jpg
*.gif

# --- Data & Output ---
# Folders for convergence history or exported data
results/
data/output/

# Folders for figures and animations generated by Python scripts
py_fig_*/

# --- System Files ---
# macOS and Windows system files
.DS_Store
Thumbs.db
